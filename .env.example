# Скопируй этот файл в .env и вставь свои значения.
# На bothost.ru те же переменные задаются в настройках бота → «Переменные окружения».

# Токен бота от @BotFather (bothost подставляет его сам)
BOT_TOKEN=your_bot_token_here

# Хозяин бота: ему доступны скрытые /debug и /say. По умолчанию — @SkullOfGods
# OWNER_ID=384144294

# Куда слать бэкапы базы. По умолчанию — в личку хозяину (нужно один раз написать боту /start).
# off — выключить бэкапы
# BACKUP_CHAT_ID=384144294

# Как часто бэкапить базу, если она менялась (минуты)
# BACKUP_INTERVAL_MINUTES=60

# Где лежит база. По умолчанию /app/data/bot.db на bothost (эта папка не стирается при обновлении)
# или data/bot.db рядом с ботом
# DATABASE_PATH=/app/data/bot.db

# Часовой пояс беседы относительно UTC (3 — Москва)
# TZ_OFFSET_HOURS=3

# Мини-приложение казино. На bothost адрес берётся из DOMAIN сам, когда включён домен
# WEBAPP_URL=https://твой-домен
# Короткое имя приложения, если создавал его через /newapp в BotFather
# CASINO_APP_NAME=

# Донаты рублями по СБП: номер телефона и (необязательно) банк. Пусто — донаты выключены.
# Номер задавай в переменных на хостинге, а не в коде: репозиторий публичный
# DONATE_PHONE=+79990000000
# DONATE_BANK=Т-Банк

# Кулдаун /d20, /who, /dnd, дуэлей и русской рулетки (минуты)
# GAME_COOLDOWN_MINUTES=20

# Спам-день: с какого часа начинается и какие кулдауны в этот день (секунды)
# SPAM_DAY_HOUR=10
# SPAM_DAY_COOLDOWN_SECONDS=5

# Премия рекордсменам бесконечных игр: с какого часа её выдавать
# ARCADE_PRIZE_HOUR=13

# Сглыпа: бот вставляет случайную фразу раз в столько сообщений
# SGLYPA_MIN_MESSAGES=150
# SGLYPA_MAX_MESSAGES=200

# Кулдаун оргии в часах (по умолчанию 24)
ORGY_COOLDOWN_HOURS=24

# Время опроса оргии в секундах (по умолчанию 60)
ORGY_POLL_DURATION_SECONDS=60
